# GridWorldRAG 環境設定テンプレート
# このファイルを config.env にコピーして実際の値を設定してください
# cp config.env.example config.env

# Google OAuth 認証
GOOGLE_EMAIL=your-email@example.com
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# PostgreSQL
# PGDATABASE: ad-hoc psql 等で --db を省略した時のデフォルト DB。
# MCP と自動スクリプトは --db 引数で個別に指定するので、ここは参考値。
PGDATABASE=gridworldrag_0
# DB名称マッピング (list_dbs.sh の表示ラベル用)
# インデックス:名称 をカンマ区切り、例: 0:test,3:prod,4:new
DB_NAMES=0:default
PGUSER=your-username
PGHOST=localhost
PGPORT=5432

# インデックス対象スコープ
# 0=対象外, 1=対象
INDEX_MY_DRIVE=0
INDEX_SHARED_DRIVES=1
INDEX_IMAGE_OCR=0

# 並列ワーカー数（calc_workers.py で自動設定推奨）
PARALLEL_WORKERS=8

# タスク分割閾値（この数を超えるドライブは分割して並列処理）
TASK_SPLIT_THRESHOLD=5000

# モニター表示の更新間隔（ミリ秒）
MONITOR_INTERVAL_MS=800

# ワーカー起動間隔（秒）
WORKER_START_INTERVAL_SEC=5

# ファイル一覧取得の並列スレッド数
FETCH_THREADS=3
