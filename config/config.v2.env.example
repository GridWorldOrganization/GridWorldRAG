# WinServerRAG runtime configuration — v0.2 template
# Copy this file to config/config.v2.env and fill in the real values.

# --- Google OAuth ---
GOOGLE_EMAIL=you@example.com
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxx
# Path to the OAuth refresh token. Plain filename = next to this file
# (i.e. CONFIG_DIR/token.pickle). Legacy "config/token.pickle" form is
# still honored for backward compat (resolves under DATA_ROOT).
GOOGLE_TOKEN_PATH=token.pickle

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
# Required. Set your postgres user password.
PGPASSWORD=change_me
PGDATABASE=winserverrag

# --- Indexing scope & behavior ---
INDEX_IMAGE_OCR=0
DRIVE_DOWNLOAD_TIMEOUT_SEC=30

# --- Embedding ---
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DEVICE=auto
CHUNK_SIZE=600
CHUNK_OVERLAP=120
BATCH_SIZE=64

# --- API retry ---
API_MAX_RETRIES=6
API_BASE_DELAY_SEC=5
API_SHEET_MAX_RETRIES=6

# --- Daemon ---
DAEMON_ROTATE_INTERVAL_SEC=300
DAEMON_MIN_FREE_BYTES=1073741824
# Initial parallel worker threads. Live adjustable via /api/workers/scale (1..10).
DAEMON_WORKER_THREADS=4

# --- Control API ---
API_HOST=127.0.0.1
API_PORT=17600
# Bearer token required for non-localhost HTTP access to admin endpoints.
# Leave empty = strict localhost-only for /api/*. (MCP has its own Basic Auth.)
API_BEARER_TOKEN=
