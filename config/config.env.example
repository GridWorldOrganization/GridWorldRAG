# WinServerRAG configuration template
# Copy to config/config.env and fill in values

# --- Google OAuth ---
GOOGLE_EMAIL=you@example.com
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxx
# Path relative to project root (optional)
GOOGLE_TOKEN_PATH=config/token.pickle

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
# Required. Set your postgres user password.
PGPASSWORD=change_me
PGDATABASE=winserverrag

# --- Indexing scope & behavior ---
INDEX_IMAGE_OCR=0
DRIVE_DOWNLOAD_TIMEOUT_SEC=30

# --- Embedding ---
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
# auto / cpu / cuda
EMBEDDING_DEVICE=auto
CHUNK_SIZE=600
CHUNK_OVERLAP=120
BATCH_SIZE=64

# --- API retry ---
API_MAX_RETRIES=6
API_BASE_DELAY_SEC=5
API_SHEET_MAX_RETRIES=6

# --- Daemon ---
# Seconds between rotation sweeps. Each sweep enqueues enabled FDs that aren't
# already being processed by a worker.
DAEMON_ROTATE_INTERVAL_SEC=300
# Min free disk bytes to consider DB safe to write (1 GB default)
DAEMON_MIN_FREE_BYTES=1073741824
# Parallel worker threads (initial). Adjustable live at runtime via
# /api/workers/scale (1..10). Default 4.
DAEMON_WORKER_THREADS=4

# --- Control API ---
API_HOST=127.0.0.1
API_PORT=17600
# Bearer token required for LAN/remote access (leave empty = localhost only)
API_BEARER_TOKEN=
