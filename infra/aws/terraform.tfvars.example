# Copy to terraform.tfvars and fill in real values. terraform.tfvars is
# gitignored so secrets stay local. Apply with:
#   ./bin/terraform.exe apply

basic_user = "your-mcp-username"
basic_pass = "use-a-long-random-password"

# Optional overrides:
# region      = "ap-northeast-1"
# aws_profile = "sandbox2"
